{
  "expo": {
    "name": "غاز أرون",
    "slug": "gaz-aron",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#3880C7"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gazaron.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3880C7"
      },
      "package": "com.gazaron.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}
